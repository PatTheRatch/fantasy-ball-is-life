# Copy to .env.local and fill in for local development.
#   VITE_DEV_TOKEN: a real Supabase-issued JWT (dev-only shim; the backend still
#                   verifies it — this never bypasses auth).
#   VITE_API_BASE_URL: override the same-origin API base (default: same origin).
#   VITE_API_PROXY_TARGET: where `vite dev` forwards /api (default: localhost:8000).
VITE_DEV_TOKEN=
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8000
