# Secrets — never commit credentials or cookies
.env
*.pem

# Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / frontend build
node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local

# IDE / OS
.idea/
.vscode/
.DS_Store

# Data files live outside git (user-uploaded projections, pulled league data, local DBs)
data/*
player_rankings/*
league_*/
*.csv
*.xls
*.xlsx
*.db
*.db-shm
*.db-wal

# Keep placeholder dirs
!data/.gitkeep

# Committed test fixtures are the exception. The rule above exists to keep
# user-uploaded projections and pulled league data out of git — but a synthetic
# fixture that tests depend on MUST be committed (§6.1: CI has no other copy).
# Scoped to this one directory rather than a blanket `!*.csv`, so it cannot
# accidentally un-ignore a real projection dump placed anywhere else.
!tests/fixtures/projections/*.csv
!player_rankings/.gitkeep

# macOS duplicate-file artifacts ("foo 2.ext")
* 2.*
# Added by code-review-graph
.code-review-graph/
