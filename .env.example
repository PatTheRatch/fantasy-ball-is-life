# Copy to `.env` and fill in real values. `.env` is gitignored — never commit
# credentials. These are live ESPN session cookies, not config.

# ESPN session cookies (from your browser's espn.com cookies after logging in).
FCP_ESPN_SWID=
FCP_ESPN_ESPN_S2=

# The ESPN league id (an id, not a secret, but it belongs with the others).
FCP_ESPN_LEAGUE_ID=

# The application database (SQLAlchemy URL).
DATABASE_URL=
