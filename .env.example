# Copy to `.env` and fill in real values. `.env` is gitignored — never commit
# credentials or secrets.

# --- ESPN (for scripts/sync_league.py) ---
# Live ESPN session cookies, from your browser's espn.com cookies after logging
# in. Never pass these on the command line.
FCP_ESPN_SWID=
FCP_ESPN_ESPN_S2=

# The ESPN league id (an id, not a secret, but it belongs with the others).
FCP_ESPN_LEAGUE_ID=

# --- Supabase auth (for the backend's JWT verification) ---
# The issuer (iss claim) of Supabase-issued JWTs, e.g.
#   https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=

# The audience (aud claim) of Supabase-issued JWTs, normally `authenticated`.
SUPABASE_JWT_AUDIENCE=

# The JWKS endpoint the backend loads signing keys from, e.g.
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# --- Database ---
# The application database (SQLAlchemy URL).
DATABASE_URL=
